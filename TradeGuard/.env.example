# Copy this file to .env and fill in values locally.
# Never commit the resulting .env file.

# LLM provider: auto, openai, or anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TG_MODEL=gpt-5.4-mini
TG_MODEL_CLASSIFY=gpt-5.4-mini

# Bank of Korea ECOS
ECOS_API_KEY=

# Public Data Portal / Korea Customs Service
DATA_GO_KR_KEY=
