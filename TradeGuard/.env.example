# Copy this file to .env and fill in values locally.
# Never commit the resulting .env file.
#   cp .env.example .env
# 진단: python3 pipeline/llm.py --check --live   /   python3 pipeline/fx_rates.py --check

# ── LLM (서류 추출) ────────────────────────────────
# Claude / GPT 둘 중 하나만 있으면 됩니다.
LLM_PROVIDER=auto          # auto | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 모델 오버라이드 — 비워두면 프로바이더별 기본값 사용
#   openai    기본: gpt-4o / gpt-4o-mini
#   anthropic 기본: claude-sonnet-4-5 / claude-haiku-4-5-20251001
# ※ 여기에 적은 모델명이 실제 계정에서 사용 가능한지 llm.py --check --live 로 확인할 것
TG_MODEL=
TG_MODEL_CLASSIFY=

# 하자 '판정'은 항상 결정적 규칙으로 수행됩니다(LLM 미사용).
# 아래를 1로 두면 하자 '설명 문장'만 LLM이 다듬습니다 — 데모용, 소액 과금 발생.
TG_EXPLAIN_LLM=0

# ── 공공 데이터 ────────────────────────────────────
# 한국은행 ECOS (환율 · 통계코드 731Y001) — 환노출 모듈의 주 데이터원
ECOS_API_KEY=

# 공공데이터포털 — 관세청_관세환율정보(GW)  https://www.data.go.kr/data/15101230/openapi.do
# ※ 반드시 '디코딩(원본)' 키. 인코딩 키를 넣으면 재인코딩되어 인증 오류가 납니다.
DATA_GO_KR_KEY=

# 공공데이터포털 — 관세청_품목별 국가별 수출입실적(GW)  https://www.data.go.kr/data/15100475/openapi.do
# 계정당 인증키가 하나면 비워두세요 (DATA_GO_KR_KEY를 자동으로 사용)
DATA_GO_KR_KEY_TRADE=
