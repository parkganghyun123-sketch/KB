.DS_Store
node_modules/

# 시크릿 — API 키는 절대 커밋 금지
.env
.env.*
!.env.example
*.key
secrets.json

# 가상환경 — 어느 깊이에 만들든 잡는다.
# 실행 가이드가 `cd TradeGuard && python3 -m venv .venv`를 안내하므로
# 저장소 루트가 아니라 하위 폴더에 생긴다. 규칙이 없으면 `git add -A` 한 번에
# 수천 개 파일이 딸려 들어가고, 제출 ZIP에도 그대로 담긴다.
.venv/
venv/
env/
ENV/
*.egg-info/
.python-version

# 산출물
__pycache__/
*.py[cod]
TradeGuard/render/out/
TradeGuard/.demo.*.log

# 렌더 산출물 120장(12MB)은 커밋하지 않는다 — generate_cases.py + render.py로 언제든 재생성된다.
# 다만 **업로드 모드 데모용 2케이스(6장)는 예외로 포함**한다.
# 이게 없으면 저장소를 클론한 심사위원은 Playwright + chromium을 설치해야만
# "이미지를 올리면 AI가 읽는다"는 핵심 장면을 재현할 수 있다.
# 디렉터리 자체를 무시하면 하위 예외가 먹지 않으므로 `/*`로 지정한다.
TradeGuard/benchmark/cases/rendered/*
!TradeGuard/benchmark/cases/rendered/CLEAN-017_*.png
!TradeGuard/benchmark/cases/rendered/DEFECT-019_*.png
TradeGuard/benchmark/.e2e*.log

# 제출물 패키징 산출물
dist/

# 대회 제출 서류 — 작성 시 성명·생년월일·전화번호·이메일·주소가 들어간다.
# 이 저장소는 공개 원격(GitHub)에 푸시되므로 절대 커밋하지 않는다.
# 제출은 대회 포털에 직접 업로드한다.
# 주의: gitignore에서 [ ] 는 문자 클래스라 반드시 이스케이프해야 한다.
# 폴더명이 macOS에서 NFD로 저장될 수 있어 와일드카드도 함께 둔다.
\[KB AICHALLENGE*\]/
*AICHALLENGE*/
*참가신청서*.pdf
*서약서*.pdf
*개인정보*.pdf

*.pptx

# 재심사 감사 이력 — 로컬 실행 산출물이라 커밋하지 않는다
TradeGuard/audit/
